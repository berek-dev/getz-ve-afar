{
  "name": "getz-ve-afar",
  "private": true,
  "version": "0.1.0",
  "description": "גץ ועפר – כלי עבודה פנימי: מדידה, כתב כמויות, הצעת מחיר וניהול עבודות",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "tsc -p tsconfig.json --noEmit && node --no-warnings scripts/build-3d-prototype.ts && vite build",
    "build:3d": "node --no-warnings scripts/build-3d-prototype.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test \"src/core/**/*.test.ts\" \"server/**/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply getz-ve-afar --local",
    "db:migrate:remote": "wrangler d1 migrations apply getz-ve-afar --remote",
    "db:seed:local": "wrangler d1 execute getz-ve-afar --local --file seed/demo.sql",
    "db:seed:remote": "wrangler d1 execute getz-ve-afar --remote --file seed/demo.sql",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
